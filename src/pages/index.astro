---
import { siteConfig } from "../config";
import "../styles/global.css";

const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  const cleanPath = path.replace(/^\/+/, "");
  return `${base}${cleanPath}`;
};

const faviconSrc = siteConfig.logoImage?.src
  ? withBase(siteConfig.logoImage.src)
  : withBase("images/Mucu1.png");
const siteUrl = Astro.site ?? new URL("https://mucunguzi.tech");
const canonicalUrl = new URL(import.meta.env.BASE_URL, siteUrl).href;
const socialImageSrc = siteConfig.heroImage?.src
  ? withBase(siteConfig.heroImage.src)
  : withBase("images/mucudev.png");
const socialImageUrl = new URL(socialImageSrc, siteUrl).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  jobTitle: siteConfig.title,
  description: siteConfig.description,
  url: canonicalUrl,
  image: socialImageUrl,
  sameAs: [
    siteConfig.social.github,
    siteConfig.social.linkedin,
    siteConfig.social.twitter,
  ],
  knowsAbout: siteConfig.keywords,
};

const skillsGrid = [
  { category: "Languages", tools: "PHP, TypeScript, Solidity, JavaScript" },
  { category: "Frameworks", tools: "Next.js 14, React, Astro, Laravel" },
  { category: "Blockchain", tools: "Mantle Network, Hedera HCS, Chainlink, Celo" },
  { category: "Payments", tools: "Flutterwave, MTN MoMo, Kotani Pay" },
  { category: "Infra", tools: "Supabase, IPFS/Pinata, Vercel, GitHub Actions" },
  { category: "Tools", tools: "WP-CLI, Evolution API, n8n, Typebot" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={faviconSrc} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />
    <meta name="keywords" content={siteConfig.keywords.join(", ")} />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={`${siteConfig.name} - ${siteConfig.title}`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={siteConfig.heroImage?.alt || siteConfig.logoImage?.alt || siteConfig.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${siteConfig.name} - ${siteConfig.title}`} />
    <meta name="twitter:description" content={siteConfig.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} - {siteConfig.title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[#0a0a0f] text-gray-100 font-outfit antialiased">
    <div class="noise-overlay"></div>
    <nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl bg-[#0a0a0f]/80 border-b border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="text-xl font-bold tracking-tight text-white font-mono">
            <span class="text-cyan-400">&lt;</span>Mucunguzi<span class="text-cyan-400">/&gt;</span>
          </a>
          <div class="hidden md:flex items-center gap-8">
            <a href="#projects" class="text-sm text-gray-400 hover:text-cyan-400 transition-colors">Projects</a>
            <a href="#experience" class="text-sm text-gray-400 hover:text-cyan-400 transition-colors">Experience</a>
            <a href="#about" class="text-sm text-gray-400 hover:text-cyan-400 transition-colors">About</a>
            <a href="#contact" class="text-sm text-gray-400 hover:text-cyan-400 transition-colors">Contact</a>
          </div>
          <button id="theme-toggle" class="p-2 bg-transparent hover:bg-white/5 transition-all duration-300 group">
            <span class="text-cyan-400 font-mono text-sm group-hover:animate-pulse">{ }</span>
          </button>
        </div>
      </div>
    </nav>

    <main class="pt-24">
      <section class="min-h-[90vh] px-4 sm:px-6 lg:px-8 py-12">
        <div class="max-w-7xl mx-auto h-full">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-5 flex justify-center lg:justify-end order-1 lg:order-2">
              <img
                src="/images/mucudev.png"
                alt="Mucunguzi Moses speaking at a tech event"
                width="420"
                height="460"
                loading="eager"
                decoding="async"
                class="hero-photo"
              />
            </div>
            <div class="lg:col-span-7 max-w-4xl order-2 lg:order-1">
              <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono mb-6">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Currently building AsiliChain & KlassApp
              </span>
              <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-white mb-4 leading-tight font-mono">
                Mucunguzi Moses
              </h1>
              <p class="text-xl sm:text-2xl text-cyan-400 font-mono mb-6">Fullstack Developer · Web3 · African-first</p>
              <p class="text-lg text-gray-400 mb-8 max-w-2xl leading-relaxed">
                {siteConfig.heroBio}
              </p>
              <div class="flex flex-wrap gap-2 mb-8">
                {siteConfig.skills.map((skill) => (
                  <span class="px-3 py-1.5 rounded-md bg-white/5 border border-white/10 text-gray-300 text-sm font-mono">{skill}</span>
                ))}
              </div>
              <div class="flex flex-col sm:flex-row gap-4">
                <a 
                  href={siteConfig.social.calendly || "https://calendly.com/moemucu"} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center px-6 py-3 bg-cyan-500 text-white font-semibold font-mono transition-all duration-300 hover:bg-cyan-400 hover:shadow-lg hover:shadow-cyan-500/30 hover:-translate-y-0.5"
                >
                  Contract Me
                </a>
                <a 
                  href="#projects"
                  class="inline-flex items-center justify-center px-6 py-3 border border-amber-500/50 text-amber-400 font-mono transition-all duration-300 hover:bg-amber-500/10 hover:border-amber-400 hover:-translate-y-0.5"
                >
                  View Projects
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="about" class="px-4 sm:px-6 lg:px-8 py-16">
        <div class="max-w-7xl mx-auto">
          <h2 class="text-3xl font-bold text-white mb-12 font-mono">
            <span class="text-cyan-400">//</span> About
          </h2>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
            <div class="bento-card p-8">
              <p class="text-lg text-gray-300 leading-relaxed">
                {siteConfig.aboutMe}
              </p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="bento-card p-6 text-center">
                <div class="text-3xl font-bold text-cyan-400 font-mono mb-1">5 yrs</div>
                <div class="text-sm text-gray-400">Full-stack experience</div>
              </div>
              <div class="bento-card p-6 text-center">
                <div class="text-3xl font-bold text-cyan-400 font-mono mb-1">3</div>
                <div class="text-sm text-gray-400">Ventures currently active</div>
              </div>
              <div class="bento-card p-6 text-center">
                <div class="text-3xl font-bold text-cyan-400 font-mono mb-1">2</div>
                <div class="text-sm text-gray-400">Countries with deployed products</div>
              </div>
            </div>
          </div>
          <div class="bento-card p-8">
            <h3 class="text-xl font-semibold text-white mb-6 font-mono">What I Work With</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {skillsGrid.map((item) => (
                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 p-4 bg-white/5 rounded-lg">
                  <span class="text-cyan-400 font-mono text-sm min-w-[100px]">{item.category}</span>
                  <span class="text-gray-400 text-sm">{item.tools}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="projects" class="px-4 sm:px-6 lg:px-8 py-16">
        <div class="max-w-7xl mx-auto">
          <h2 class="text-3xl font-bold text-white mb-12 font-mono">
            <span class="text-cyan-400">&lt;</span>Projects<span class="text-cyan-400">/&gt;</span>
          </h2>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            {siteConfig.projects.map((project, idx) => {
              const isFeatured = (project as any).featured;
              if (isFeatured) {
                return (
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="bento-card featured-card p-8 lg:col-span-2 group relative overflow-hidden">
                    <div class="absolute top-4 left-4 px-2 py-1 bg-cyan-500/20 text-cyan-400 text-xs font-mono border border-cyan-500/30">
                      &lt;{project.number}/&gt;
                    </div>
                    <div class="pt-8">
                      <h3 class="text-2xl sm:text-3xl font-bold text-white mb-3 group-hover:text-cyan-300 transition-colors">
                        {project.name}
                      </h3>
                      <p class="text-gray-300 mb-4 max-w-2xl leading-relaxed">
                        {project.description}
                      </p>
                      <div class="inline-block px-4 py-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm font-mono mb-6">
                        {project.outcomeStat}
                      </div>
                      {project.skills && project.skills.length > 0 && (
                        <div class="flex flex-wrap gap-2 mb-6">
                          {project.skills.map((skill) => (
                            <span class="px-3 py-1 bg-white/5 text-gray-400 text-xs font-mono rounded border border-white/10">
                              {skill}
                            </span>
                          ))}
                        </div>
                      )}
                      <span class="inline-flex items-center gap-2 text-cyan-400 font-mono text-sm group-hover:gap-3 transition-all">
                        View Project <span class="group-hover:translate-x-1 transition-transform">→</span>
                      </span>
                    </div>
                  </a>
                );
              }
              return (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="bento-card project-card p-8 group relative overflow-hidden">
                  <div class="absolute top-4 left-4 px-2 py-1 bg-cyan-500/20 text-cyan-400 text-xs font-mono border border-cyan-500/30">
                    &lt;{project.number}/&gt;
                  </div>
                  <div class="pt-8">
                    <h3 class="text-xl font-semibold text-white mb-3 group-hover:text-cyan-300 transition-colors">
                      {project.name}
                    </h3>
                    <p class="text-gray-400 mb-4 text-sm leading-relaxed">
                      {project.description}
                    </p>
                    <div class="inline-block px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono mb-4">
                      {project.outcomeStat}
                    </div>
                    {project.skills && project.skills.length > 0 && (
                      <div class="flex flex-wrap gap-2 mb-4">
                        {project.skills.map((skill) => (
                          <span class="px-2 py-1 bg-white/5 text-gray-500 text-xs font-mono rounded border border-white/10">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}
                    <span class="inline-flex items-center gap-2 text-cyan-400 font-mono text-sm group-hover:gap-3 transition-all">
                      View Project <span class="group-hover:translate-x-1 transition-transform">→</span>
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>

      <section id="experience" class="px-4 sm:px-6 lg:px-8 py-16">
        <div class="max-w-7xl mx-auto">
          <h2 class="text-3xl font-bold text-white mb-12 font-mono">
            <span class="text-cyan-400">&amp;</span> Experience
          </h2>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            {siteConfig.experience.map((exp, idx) => (
              <div class="bento-card experience-card p-6 group">
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-mono text-cyan-400">[{String(idx + 1).padStart(2, '0')}]</span>
                  <span class="text-xs text-gray-500 font-mono">{exp.dateRange}</span>
                </div>
                <h3 class="text-lg font-semibold text-white mb-1 group-hover:text-cyan-400 transition-colors">{exp.company}</h3>
                <p class="text-sm text-cyan-500 mb-4">{exp.title}</p>
                {exp.bullets && exp.bullets.length > 0 && (
                  <ul class="space-y-2">
                    {exp.bullets.map((bullet) => (
                      <li class="text-xs text-gray-400 flex items-start gap-3">
                        <span class="text-cyan-500 font-mono mt-0.5">›</span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="px-4 sm:px-6 lg:px-8 py-16 border-t border-white/5">
        <div class="max-w-7xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <div>
              <h2 class="text-4xl sm:text-5xl font-bold text-white mb-4 font-mono">Let's Build.</h2>
              <p class="text-lg text-gray-400 leading-relaxed">
                Open to contracts, co-founder conversations, and African ecosystem partnerships.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row lg:flex-col gap-4 lg:items-end">
              <a 
                href="https://calendly.com/moemucu" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-3 bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 font-mono text-sm hover:bg-cyan-500/20 hover:border-cyan-400 transition-colors min-h-[44px]"
              >
                <span>📅</span> Book a Call → calendly.com/moemucu
              </a>
              <a 
                href="mailto:moemucu@gmail.com"
                class="inline-flex items-center gap-2 px-5 py-3 bg-white/5 border border-white/10 text-gray-300 font-mono text-sm hover:bg-white/10 hover:border-white/20 transition-colors min-h-[44px]"
              >
                <span>✉️</span> Email → moemucu@gmail.com
              </a>
              <a 
                href="https://x.com/Mucu256" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-3 bg-white/5 border border-white/10 text-gray-300 font-mono text-sm hover:bg-white/10 hover:border-white/20 transition-colors min-h-[44px]"
              >
                <span>𝕏</span> DM on X → x.com/Mucu256
              </a>
            </div>
          </div>
        </div>
      </section>

      <footer class="px-4 sm:px-6 lg:px-8 py-12 border-t border-white/5">
        <div class="max-w-7xl mx-auto">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-8">
            <div class="font-mono text-lg text-white">
              <span class="text-cyan-400">&lt;</span>Mucunguzi/<span class="text-cyan-400">&gt;</span> · Kampala, Uganda
            </div>
            <div class="flex items-center gap-6">
              <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-cyan-400 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </a>
              <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-cyan-400 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-cyan-400 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            </div>
          </div>
          <div class="text-center">
            <p class="text-sm text-gray-500 font-mono">© 2026 Mucunguzi Moses. Built with Astro. Open source.</p>
          </div>
        </div>
      </footer>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.bento-card').forEach((card, i) => {
          card.classList.add('reveal');
          card.classList.add(`reveal-delay-${(i % 4) + 1}`);
          observer.observe(card);
        });

        const themeToggle = document.getElementById('theme-toggle');
        themeToggle?.addEventListener('click', () => {
          document.documentElement.classList.toggle('light');
        });
      });
    </script>
  </body>
</html>