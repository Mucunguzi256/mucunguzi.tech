---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="section-container">
      <div class="section-header">
        <h2>Education</h2>
        <div class="accent-bar" />
      </div>

      <div class="max-w-3xl mx-auto space-y-5">
        {
          siteConfig.education.map((edu) => {
            const firstUrl = edu.achievements.find((a) => a.startsWith("http"));
            const Component = firstUrl ? "a" : "div";
            const linkProps = firstUrl
              ? {
                  href: firstUrl,
                  target: "_blank",
                  rel: "noopener noreferrer",
                }
              : {};

            return (
              <Component
                {...linkProps}
                class="bento-card reveal"
                style={`
                  padding: var(--space-5);
                  display: block;
                  text-decoration: none;
                  cursor: ${firstUrl ? 'pointer' : 'default'};
                `}
              >
                <div
                  style={`
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: space-between;
                    align-items: flex-start;
                    gap: var(--space-2);
                    margin-bottom: var(--space-2);
                  `}
                >
                  <div>
                    <h3 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--fg);">
                      {edu.degree}
                    </h3>
                    <p style="color: var(--accent-2); font-size: var(--text-base);">
                      {edu.school}
                    </p>
                  </div>
                  <span style="font-size: var(--text-sm); color: var(--fg-3); font-family: var(--font-mono); white-space: nowrap;">
                    {edu.dateRange}
                  </span>
                </div>
              </Component>
            );
          })
        }
      </div>
    </section>
  )
}
