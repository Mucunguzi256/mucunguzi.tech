---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="section-container">
      <div class="section-header">
        <h2>Experience</h2>
        <div class="accent-bar" />
      </div>

      <div class="max-w-3xl mx-auto">
        {
          siteConfig.experience.map((exp, index) => (
            <div
              class="reveal"
              style={`
                position: relative;
                padding-left: var(--space-8);
                padding-bottom: ${index < siteConfig.experience.length - 1 ? 'var(--space-8)' : '0'};
              `}
            >
              {/* Timeline line */}
              {index < siteConfig.experience.length - 1 && (
                <div
                  style={`
                    position: absolute;
                    left: 7px;
                    top: var(--space-6);
                    bottom: 0;
                    width: 2px;
                    background: var(--border);
                  `}
                />
              )}

              {/* Timeline dot */}
              <div
                style={`
                  position: absolute;
                  left: 0;
                  top: var(--space-2);
                  width: 16px;
                  height: 16px;
                  border-radius: 50%;
                  background: var(--accent);
                  border: 3px solid var(--bg);
                  box-shadow: 0 0 0 2px var(--accent);
                `}
              />

              {/* Experience card */}
              <div class="bento-card" style="padding: var(--space-5);">
                <div
                  style={`
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: space-between;
                    align-items: flex-start;
                    gap: var(--space-2);
                    margin-bottom: var(--space-3);
                  `}
                >
                  <div>
                    <h3
                      style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--fg);"
                    >
                      {exp.title}
                    </h3>
                    <p style="color: var(--accent-2); font-size: var(--text-base);">
                      {exp.company}
                    </p>
                  </div>
                  <span
                    style="font-size: var(--text-sm); color: var(--fg-3); font-family: var(--font-mono); white-space: nowrap;"
                  >
                    {exp.dateRange}
                  </span>
                </div>

                <ul style="space-y: var(--space-2);">
                  {
                    exp.bullets.map((bullet) => (
                      <li
                        style={`
                          display: flex;
                          align-items: flex-start;
                          gap: var(--space-2);
                          font-size: var(--text-sm);
                          color: var(--fg-2);
                          line-height: 1.6;
                        `}
                      >
                        <span
                          style={`
                            display: inline-block;
                            width: 5px;
                            height: 5px;
                            border-radius: 50%;
                            background: var(--fg-3);
                            margin-top: 0.6em;
                            flex-shrink: 0;
                          `}
                        />
                        <span>{bullet}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  )
}
