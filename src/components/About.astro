---
import { siteConfig } from "../config";
const aboutImages = siteConfig.aboutImages || [];
const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  const cleanPath = path.replace(/^\/+/, "");
  return `${base}${cleanPath}`;
};
const resolvedAboutImages = aboutImages
  .filter((img) => !img.src.includes("Mucubit.png"))
  .map((img) => ({ ...img, src: withBase(img.src) }));
const vitalikImage = resolvedAboutImages.length > 0 ? resolvedAboutImages[0] : null;
---

<section id="about" class="section-container">
  <div class="section-header">
    <h2>About Me</h2>
    <div class="accent-bar" />
  </div>

  <div class="about-grid">
    {/* Photo card */}
    {vitalikImage && (
      <div class="bento-card photo-card reveal reveal-delay-1">
        <div class="photo-wrapper">
          <img
            src={vitalikImage.src}
            alt={vitalikImage.alt || "About image"}
            class="about-photo"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    )}

    {/* Bio card */}
    <div class="bento-card bio-card reveal reveal-delay-1">
      <span class="syntax-deco syntax-deco-tr">import&nbsp;</span>
      <p class="bio-text">{siteConfig.aboutMe}</p>
    </div>

    {/* Stats + Skills row */}
    <div class="stats-skills-row reveal reveal-delay-3">
      {/* Stats card */}
      <div class="bento-card stats-card">
        <span class="syntax-deco syntax-deco-tl">[&ensp;]</span>
        <div class="stats-grid">
          <div class="about-stat">
            <span class="about-stat-value">5+</span>
            <span class="about-stat-label">Years of experience</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-value">6</span>
            <span class="about-stat-label">Projects shipped</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-value">3</span>
            <span class="about-stat-label">Ventures active</span>
          </div>
        </div>
      </div>

      {/* Skills card */}
      <div class="bento-card skills-card">
        <span class="syntax-deco syntax-deco-tr">const&nbsp;</span>
        <div class="skills-tags">
          {siteConfig.skills.map((skill) => (
            <span class="skill-tag">{skill}</span>
          ))}
        </div>
      </div>
    </div>

    {/* Full-width statement */}
    <div class="bento-card statement-card reveal reveal-delay-4">
      <p class="statement-text">
        I build at the intersection of Web3 infrastructure, African market realities, and open source. The continent's best technology is still unwritten.
      </p>
    </div>
  </div>
</section>

<style is:global>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr 1fr;
    }

    .about-grid > .stats-skills-row {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }

    .about-grid > .statement-card {
      grid-column: 1 / -1;
    }
  }

  /* Photo */
  .photo-card {
    padding: 0;
    overflow: hidden;
    display: flex;
  }

  .photo-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .photo-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg,
      oklch(from var(--accent) l c h / 0.2),
      oklch(from var(--accent-2) l c h / 0.1));
    pointer-events: none;
  }

  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
    display: block;
    filter: sepia(0.4) saturate(1.3) hue-rotate(-5deg);
  }

  /* Bio */
  .bio-card {
    padding: var(--space-6);
    border-left: 3px solid var(--accent);
  }

  .bio-text {
    font-size: var(--text-lg);
    color: var(--fg-2);
    line-height: 1.7;
    margin: 0;
  }

  /* Stats */
  .stats-card {
    padding: var(--space-5);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .about-stat {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .about-stat-value {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .about-stat-label {
    font-size: var(--text-xs);
    color: var(--fg-3);
  }

  /* Skills */
  .skills-card {
    padding: var(--space-5);
  }

  .skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-content: flex-start;
  }

  .skill-tag {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--surface-2);
    color: var(--fg-2);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 500;
    border: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
    cursor: default;
  }

  .skill-tag:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  /* Statement */
  .statement-card {
    padding: var(--space-6);
    text-align: center;
  }

  .statement-text {
    font-size: var(--text-lg);
    color: var(--fg-2);
    line-height: 1.6;
    max-width: 640px;
    margin: 0 auto;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .bio-card {
      padding: var(--space-4);
    }

    .bio-text {
      font-size: var(--text-base);
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .statement-text {
      font-size: var(--text-base);
    }
  }
</style>
