---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="section-container">
      <div class="section-header">
        <h2>Projects</h2>
        <div class="accent-bar" />
      </div>

      <div class="projects-grid">
        {siteConfig.projects.map((project) => {
          const isFeatured = (project as any).featured;
          const Component = project.link ? "a" : "div";
          const linkProps = project.link
            ? {
                href: project.link,
                target: "_blank",
                rel: "noopener noreferrer",
              }
            : {};

          if (isFeatured) {
            return (
              <Component
                {...linkProps}
                class="gradient-border-card featured-card reveal"
                style="text-decoration: none; display: block;"
              >
                <span class="syntax-deco syntax-deco-tl">&lt;feature&gt;</span>
                <div class="featured-inner">
                  <div class="featured-top">
                    <div>
                      <span class="project-number">{project.number}</span>
                      <h3 class="project-name featured-name">{project.name}</h3>
                    </div>
                    <span class="project-arrow">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="7" y1="17" x2="17" y2="7" />
                        <polyline points="7 7 17 7 17 17" />
                      </svg>
                    </span>
                  </div>

                  <p class="project-desc featured-desc">{project.description}</p>

                  {project.outcomeStat && (
                    <div class="outcome-stat">{project.outcomeStat}</div>
                  )}

                  {project.skills && project.skills.length > 0 && (
                    <div class="project-skills">
                      {project.skills.map((skill: string) => (
                        <span class="project-skill-tag">{skill}</span>
                      ))}
                    </div>
                  )}

                  {project.link && (
                    <span class="project-view-link">
                      View Project
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="7" y1="17" x2="17" y2="7" />
                        <polyline points="7 7 17 7 17 17" />
                      </svg>
                    </span>
                  )}
                </div>
              </Component>
            );
          }

          return (
            <Component
              {...linkProps}
              class="bento-card project-card reveal"
              style="text-decoration: none; display: block; padding: var(--space-5);"
            >
              <span class="syntax-deco syntax-deco-tr">&lt;&sol;&gt;</span>
              <span class="project-number" style="margin-bottom: var(--space-2); display: block;">
                {project.number}
              </span>
              <h3 class="project-name">{project.name}</h3>
              <p class="project-desc">{project.description}</p>

              {project.skills && project.skills.length > 0 && (
                <div class="project-skills" style="margin-top: var(--space-3);">
                  {project.skills.map((skill: string) => (
                    <span class="project-skill-tag">{skill}</span>
                  ))}
                </div>
              )}
            </Component>
          );
        })}
      </div>
    </section>
  )
}

<style is:global>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr 1fr;
    }

    .projects-grid > .featured-card {
      grid-column: 1 / -1;
    }
  }

  /* Featured card styles */
  .featured-inner {
    padding: var(--space-6) var(--space-7);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .featured-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .project-number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-3);
    letter-spacing: 0.05em;
  }

  .project-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--fg);
    margin: 0;
    transition: color 0.2s ease;
  }

  .featured-name {
    font-size: var(--text-2xl);
  }

  .gradient-border-card:hover .project-name {
    color: var(--accent);
  }

  .project-arrow {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: oklch(from var(--accent) l c h / 0.15);
    color: var(--accent);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .gradient-border-card:hover .project-arrow {
    transform: translate(2px, -2px);
    background: oklch(from var(--accent) l c h / 0.25);
  }

  .project-desc {
    font-size: var(--text-sm);
    color: var(--fg-2);
    line-height: 1.6;
    margin: 0;
  }

  .featured-desc {
    font-size: var(--text-base);
    max-width: 600px;
  }

  .outcome-stat {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: oklch(from var(--accent-2) l c h / 0.15);
    border: 1px solid oklch(from var(--accent-2) l c h / 0.3);
    color: var(--accent-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    border-radius: var(--radius-sm);
  }

  .project-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-skill-tag {
    padding: 0.2rem 0.6rem;
    background: var(--surface-2);
    color: var(--fg-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .gradient-border-card:hover .project-skill-tag {
    border-color: oklch(from var(--accent-2) l c h / 0.3);
    color: var(--accent-2);
  }

  .project-view-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    transition: gap 0.2s ease;
    margin-top: var(--space-1);
  }

  .gradient-border-card:hover .project-view-link {
    gap: var(--space-2);
  }

  /* Regular project card */
  .project-card {
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }

  .project-card:hover .project-name {
    color: var(--accent-2);
  }

  @media (max-width: 768px) {
    .featured-inner {
      padding: var(--space-4);
    }

    .featured-name {
      font-size: var(--text-xl);
    }
  }
</style>
