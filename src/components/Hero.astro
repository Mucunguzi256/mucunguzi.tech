---
import { siteConfig } from "../config";
const heroImage = siteConfig.heroImage;
const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  const cleanPath = path.replace(/^\/+/, "");
  return `${base}${cleanPath}`;
};
const heroImageSrc = heroImage?.src ? withBase(heroImage.src) : null;
const hasCalendly = siteConfig.social.calendly;
---

<section id="hero" class="section-container" style="padding-top: var(--space-11); padding-bottom: 0;">
  <div class="hero-grid">
    {/* CARD 1 — Main content (spans 4 cols, 2 rows on desktop) */}
    <div class="bento-card hero-main">
      <span class="syntax-deco syntax-deco-tl">&lt; &sol;&gt;</span>
      <span class="syntax-deco syntax-deco-br">{  }  </span>
      {/* CLI Terminal animation */}
      <div class="cli-widget" id="cli-widget" aria-label="Terminal typing animation">
        <span class="cli-prompt">$</span>
        <span class="cli-text" id="cli-text"></span>
        <span class="cli-cursor" id="cli-cursor">&#9611;</span>
      </div>

      <h1 class="hero-name">{siteConfig.name}</h1>
      <p class="hero-title">{siteConfig.title}</p>
      <p class="hero-bio">{siteConfig.heroBio}</p>

      <div class="hero-ctas">
        <a href="#projects" class="btn-primary">View Projects</a>
        {hasCalendly && (
          <a
            href={hasCalendly}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline"
          >
            Let's Talk
          </a>
        )}
      </div>
    </div>

    {/* CARD 2 — Profile image (spans 2 cols) */}
    {heroImageSrc && (
      <div class="bento-card hero-photo-card">
        <span class="syntax-deco syntax-deco-tl">/*&nbsp;</span>
        <div class="hero-photo-wrapper">
          <img
            src={heroImageSrc}
            alt={heroImage?.alt || siteConfig.name}
            class="hero-photo"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    )}

    {/* CARD 3 — Social links (spans 2 cols) */}
    <div class="bento-card hero-social">
      <span class="syntax-deco syntax-deco-tr">\%</span>
      <div class="social-row">
        {siteConfig.social.email && (
          <a href={`mailto:${siteConfig.social.email}`} aria-label="Email" class="social-icon" title="Email">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
              <path d="M3 7l9 6l9 -6" />
            </svg>
          </a>
        )}
        {siteConfig.social.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-icon" title="GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        )}
        {siteConfig.social.linkedin && (
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon" title="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        )}
        {siteConfig.social.twitter && (
          <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="social-icon" title="Twitter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        )}
        {siteConfig.social.calendly && (
          <a href={siteConfig.social.calendly} target="_blank" rel="noopener noreferrer" aria-label="Schedule a call" class="social-icon" title="Schedule a call">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
          </a>
        )}
      </div>
      <p class="social-label">Connect</p>
    </div>

    {/* CARD 4 — Stats (spans 4 cols) */}
    <div class="bento-card hero-stats">
      <span class="syntax-deco syntax-deco-bl">=&gt;&nbsp; </span>
      <div class="stats-row">
        <div class="stat-item">
          <span class="stat-value">5+</span>
          <span class="stat-label">Years building</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">3</span>
          <span class="stat-label">Active ventures</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">Web3</span>
          <span class="stat-label">Blockchain · AI</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">UG</span>
          <span class="stat-label">Kampala, Uganda</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    // CLI typing animation
    const el = document.getElementById("cli-text");
    const cursor = document.getElementById("cli-cursor");
    if (!el) return;

    const lines = [
      "build --from uganda --global",
      "ship --network ethereum",
      "deploy --protocol asilichain",
    ];

    let lineIdx = 0;
    let charIdx = 0;
    let isDeleting = false;
    let timeout = 200;

    const tick = () => {
      const current = lines[lineIdx % lines.length];

      if (!isDeleting) {
        // Typing
        el.textContent = current.slice(0, charIdx + 1);
        charIdx++;
        timeout = 60 + Math.random() * 40;

        if (charIdx === current.length) {
          // Pause at end
          timeout = 2000;
          isDeleting = true;
        }
      } else {
        // Deleting
        el.textContent = current.slice(0, charIdx - 1);
        charIdx--;
        timeout = 20 + Math.random() * 20;

        if (charIdx === 0) {
          timeout = 400;
          isDeleting = false;
          lineIdx++;
        }
      }

      scheduleTick();
    };

    const scheduleTick = () => {
      setTimeout(tick, timeout);
    };

    // Start after a brief delay
    setTimeout(tick, 600);
  })();
</script>

<style is:global>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: auto;
    }

    .hero-main {
      grid-column: span 4;
      grid-row: span 2;
    }

    .hero-photo-card {
      grid-column: span 2;
    }

    .hero-social {
      grid-column: span 2;
    }

    .hero-stats {
      grid-column: span 4;
    }
  }

  /* Main hero card */
  .hero-main {
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
  }

  /* CLI widget */
  .cli-widget {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--syntax);
    background: oklch(0% 0 0 / 0.3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    max-width: 100%;
    overflow: hidden;
  }

  .cli-prompt {
    color: var(--accent-2);
    flex-shrink: 0;
  }

  .cli-text {
    white-space: nowrap;
    overflow: hidden;
  }

  .cli-cursor {
    animation: cli-blink 0.8s step-end infinite;
    color: var(--syntax);
    font-size: 0.9em;
  }

  @keyframes cli-blink {
    50% { opacity: 0; }
  }

  /* Hero name */
  .hero-name {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--accent);
    margin: 0;
  }

  .hero-bio {
    font-size: var(--text-base);
    color: var(--fg-2);
    line-height: 1.6;
    max-width: 540px;
    margin: 0;
  }

  /* CTA buttons */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.5rem;
    background: var(--accent);
    color: white;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary:hover {
    background: oklch(from var(--accent) calc(l + 0.05) c h);
    transform: translateY(-1px);
    box-shadow: var(--shadow-glow);
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.5rem;
    background: transparent;
    color: var(--accent);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    border: 1px solid var(--accent);
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .btn-outline:hover {
    background: oklch(from var(--accent) l c h / 0.1);
    transform: translateY(-1px);
  }

  /* Photo card */
  .hero-photo-card {
    padding: 0;
    overflow: hidden;
    display: flex;
  }

  .hero-photo-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .hero-photo-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg,
      oklch(from var(--accent) l c h / 0.25),
      oklch(from var(--accent-2) l c h / 0.1));
    pointer-events: none;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.3) saturate(1.2) hue-rotate(-5deg);
    display: block;
  }

  /* Social links card */
  .hero-social {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .social-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    color: var(--fg-2);
    background: var(--surface-2);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .social-icon:hover {
    color: var(--accent);
    background: oklch(from var(--accent) l c h / 0.15);
    transform: translateY(-2px);
  }

  .social-label {
    font-size: var(--text-xs);
    color: var(--fg-3);
    font-family: var(--font-mono);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Stats card */
  .hero-stats {
    padding: var(--space-4) var(--space-5);
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .stat-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--fg-3);
  }

  @media (max-width: 768px) {
    .hero-main {
      padding: var(--space-5);
    }

    .hero-name {
      font-size: var(--text-3xl);
    }

    .hero-title {
      font-size: var(--text-base);
    }

    .stats-row {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2);
    }

    .cli-widget {
      font-size: 0.7rem;
      padding: var(--space-2);
    }
  }
</style>
