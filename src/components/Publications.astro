---
import { siteConfig } from "../config";
const hasPublications =
  siteConfig.publications && siteConfig.publications.length > 0;
---

{
  hasPublications && (
    <section id="publications" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              My Publications
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6">
              {siteConfig.publications.map((publication) => {
                const Component = publication.link ? "a" : "div";
                const linkProps = publication.link
                  ? {
                      href: publication.link,
                      target: "_blank",
                      rel: "noopener noreferrer",
                    }
                  : {};

                return (
                  <Component
                    {...linkProps}
                    class={`block rounded-2xl border border-gray-200 bg-gray-50 p-5 sm:p-6 transition-all duration-300 ${
                      publication.link
                        ? "hover:bg-white hover:shadow-md hover:-translate-y-0.5"
                        : ""
                    }`}
                  >
                    <h3 class="text-xl font-semibold text-gray-900">
                      {publication.title}
                    </h3>
                    <p class="mt-2 text-gray-600 leading-relaxed">
                      {publication.description}
                    </p>
                    {publication.date && (
                      <p class="mt-3 text-sm text-gray-500">{publication.date}</p>
                    )}
                  </Component>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
