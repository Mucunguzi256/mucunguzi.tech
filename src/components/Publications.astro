---
import { siteConfig } from "../config";
const hasPublications = siteConfig.publications && siteConfig.publications.length > 0;
---

{
  hasPublications && (
    <section id="publications" class="section-container">
      <div class="section-header">
        <h2>My Publications</h2>
        <div class="accent-bar" />
      </div>

      <div class="max-w-3xl mx-auto space-y-5">
        {
          siteConfig.publications.map((publication) => {
            const Component = publication.link ? "a" : "div";
            const linkProps = publication.link
              ? {
                  href: publication.link,
                  target: "_blank",
                  rel: "noopener noreferrer",
                }
              : {};

            return (
              <Component
                {...linkProps}
                class="bento-card reveal"
                style={`
                  padding: var(--space-5);
                  display: block;
                  text-decoration: none;
                  cursor: ${publication.link ? 'pointer' : 'default'};
                `}
              >
                <h3 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--fg);">
                  {publication.title}
                </h3>
                <p style="margin-top: var(--space-2); font-size: var(--text-sm); color: var(--fg-2); line-height: 1.6;">
                  {publication.description}
                </p>
                {publication.date && (
                  <p style="margin-top: var(--space-3); font-size: var(--text-xs); color: var(--fg-3); font-family: var(--font-mono);">
                    {publication.date}
                  </p>
                )}
              </Component>
            );
          })
        }
      </div>
    </section>
  )
}
